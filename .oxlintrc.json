{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["typescript", "unicorn", "oxc"],
  "rules": {
    "no-console": "warn",
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx,vue}"],
      "plugins": ["typescript"],
      "rules": {
        "typescript/no-explicit-any": "warn",
        "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
      }
    },
    {
      "files": ["**/test/**", "**/*.test.ts", "**/*.spec.ts"],
      "plugins": ["vitest"],
      "env": {
        "vitest": true
      }
    }
  ],
  "env": {
    "browser": true,
    "es6": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "*.d.ts", "auto-imports.d.ts", "components.d.ts"]
}
