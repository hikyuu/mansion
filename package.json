    "dayjs": "^1.11.13",
    "element-plus": "^2.9.11",
    "jquery": "^3.7.1",
    "pinia": "^3.0.2",
    "vue": "^3.5.15"
  },
  "devDependencies": {
    "@babel/types": "^7.27.1",
    "@eslint/js": "^9.27.0",
    "@iconify-json/fa-solid": "^1.2.1",
    "@iconify-json/ic": "^1.2.2",
    "@rushstack/eslint-patch": "^1.11.0",
